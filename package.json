{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:http",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --project integration",
    "test:http": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --project http",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "tsx --env-file=.env scripts/db-migrate-test.ts",
    "db:test:setup": "tsx --env-file=.env scripts/db-test-setup.ts",
    "worker:start": "tsx --env-file=.env worker/src/index.ts",
    "worker:build": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.2.0",
    "nuxt": "4.4.8",
    "p-limit": "6.2.0",
    "pg": "8.22.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
