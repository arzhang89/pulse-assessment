# Server-local production environment template.
# Copy to a host path such as /etc/pulse/.env (mode 600). Never commit real values.

# --- Shared ---
# Use the Compose service hostname `db`. URL-encode reserved characters in the password.
DATABASE_URL=postgresql://pulse_user:REPLACE_WITH_STRONG_PASSWORD@db:5432/pulse
NODE_ENV=production
# Must be the real public HTTPS origin (trusted Origin, Secure cookies, status links).
NUXT_PUBLIC_APP_URL=https://status.example.com

# --- Web (Nitro) ---
HOST=0.0.0.0
PORT=3000
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# --- Worker ---
WORKER_CONCURRENCY=20
WORKER_NOTIFICATION_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_SHUTDOWN_GRACE_MS=60000
WORKER_DELIVERY_TIMEOUT_MS=10000
# Optional stable identity across restarts:
# WORKER_ID=worker-1

# --- PostgreSQL container ---
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=pulse

# --- Caddy / TLS ---
DOMAIN=status.example.com
# Optional Let's Encrypt contact email:
# ACME_EMAIL=ops@example.com
