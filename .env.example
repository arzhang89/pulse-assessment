# Copy to .env and adjust as needed for local development.

# PostgreSQL connection string used by both the Nuxt server and the worker.
# Matches the credentials/port in docker-compose.yml (host port 5544 is
# used to avoid colliding with a locally installed PostgreSQL on 5432).
DATABASE_URL=postgresql://pulse:pulse@localhost:5544/pulse

# Dedicated database for destructive schema integration tests.
# Must be named exactly pulse_test. Created by: npm run db:test:setup
TEST_DATABASE_URL=postgresql://pulse:pulse@localhost:5544/pulse_test

NODE_ENV=development

# Public base URL of the app (used for things like absolute links and,
# later, trusted-origin checks on state-changing requests).
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Worker runtime (used once the claim-check-persist loop is wired).
# Lease must exceed max check timeout (30s) + persistence margin (5s).
WORKER_CONCURRENCY=20
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_SHUTDOWN_GRACE_MS=60000
# Optional stable identity; otherwise hostname + random suffix.
# WORKER_ID=worker-1
